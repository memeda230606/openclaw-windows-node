<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.ModelSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <Grid RowDefinitions="Auto,*,Auto" Padding="48,28,48,28">

        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center">
            <Image Source="ms-appx:///OpenClaw.SetupEngine.UI/Assets/Setup/Lobster.png"
                   Width="64" Height="64"
                   HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="模型设置"
                       FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="13" Opacity="0.68" MaxWidth="480"
                       Text="默认使用龙王智能 API Key，可在下方选择默认模型。之后仍可在聊天框切换龙王其他模型。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,20" VerticalScrollBarVisibility="Auto">
            <Border CornerRadius="8"
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="18">
                    <CheckBox x:Name="UseLongwangCheck"
                              Content="从龙王智能获取并使用 API Key"
                              Checked="UseLongwangCheck_Changed"
                              Unchecked="UseLongwangCheck_Changed" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="龙王智能控制台"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConsoleUrlText"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Opacity="0.62" />
                        </StackPanel>
                        <Button x:Name="OpenConsoleButton"
                                Grid.Column="1"
                                MinWidth="128"
                                Height="38"
                                VerticalAlignment="Center"
                                Click="OpenConsole_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#xE8A7;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="打开控制台"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Text="龙王智能 API Key"
                                   FontSize="14" FontWeight="SemiBold" />
                        <PasswordBox x:Name="ApiKeyBox"
                                     PlaceholderText="sk-lw-v1-..."
                                     PasswordRevealMode="Peek"
                                     PasswordChanged="ApiKeyBox_PasswordChanged" />
                        <TextBlock Text="API Key 会写入本机 WSL 内的 OpenClaw 配置，不会写入安装器配置文件。"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Opacity="0.62" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="默认模型"
                                   FontSize="14" FontWeight="SemiBold" />
                        <ComboBox x:Name="ModelCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ModelCombo_SelectionChanged" />
                    </StackPanel>

                    <StackPanel x:Name="BusyPanel"
                                Visibility="Collapsed"
                                Orientation="Horizontal"
                                Spacing="10">
                        <ProgressRing x:Name="BusyRing"
                                      Width="20"
                                      Height="20"
                                      IsActive="False" />
                        <TextBlock x:Name="BusyText"
                                   Text="正在保存模型设置..."
                                   FontSize="13"
                                   Opacity="0.78"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="ErrorText"
                               Visibility="Collapsed"
                               Foreground="#FF6B6B"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button x:Name="AdvancedButton"
                    Grid.Column="0"
                    Content="使用高级网关向导"
                    Height="42"
                    MinWidth="148"
                    Click="Advanced_Click" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button x:Name="SkipButton"
                        Content="稍后配置"
                        Height="42"
                        MinWidth="96"
                        Click="Skip_Click" />

                <Button x:Name="SaveButton"
                        Content="保存并继续"
                        Height="44"
                        MinWidth="122"
                        Click="Save_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#60C8F8" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#52B0DA" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#469BBC" />
                        <SolidColorBrush x:Key="ButtonForeground" Color="Black" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black" />
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Page>
